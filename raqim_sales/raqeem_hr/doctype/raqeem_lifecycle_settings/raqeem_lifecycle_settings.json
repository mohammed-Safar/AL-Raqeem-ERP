   "options": "Basic Salary\nGross Salary",
   "default": "Basic Salary"
  },
  {
   "fieldname": "month_days",
   "fieldtype": "Int",
   "label": "Days in a Month (One Day's Pay = Pay / This)",
   "default": "30"
  },
  {
   "fieldname": "min_service_years",
   "fieldtype": "Float",
   "label": "No Gratuity Below (Years of Service)",
   "default": "1"
  },
  {
   "fieldname": "column_break_gr",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "part_years",
   "fieldtype": "Select",
   "label": "Part Years",
   "options": "Pro Rata\nFull Years Only",
   "default": "Pro Rata"
  },
  {
   "fieldname": "slab_method",
   "fieldtype": "Select",
   "label": "How the Slabs Apply",
   "options": "Each Part at Its Own Rate\nWhole Service at the Rate Reached",
   "default": "Each Part at Its Own Rate"
  },
  {
   "fieldname": "exclude_unpaid_leave",
   "fieldtype": "Check",
   "label": "Unpaid Leave Does Not Count as Service",
   "default": "1"
  },
  {
