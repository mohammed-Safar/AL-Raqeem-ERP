 "fields": [
  {
   "fieldname": "section_check",
   "fieldtype": "Section Break",
   "label": "Accountant Check",
   "description": "Rules for onboarding, exits and the end-of-service gratuity. Every rule here is editable; ask your accountant or lawyer to check them for your country, then tick the box."
  },
  {
   "fieldname": "rules_confirmed",
   "fieldtype": "Check",
   "label": "Rules Checked by Our Accountant",
   "description": "Until this is ticked, every end-of-service calculation shows a warning."
  },
  {
   "fieldname": "section_exit",
   "fieldtype": "Section Break",
   "label": "Exits"
  },
  {
   "fieldname": "notice_days",
   "fieldtype": "Int",
   "label": "Notice Period (Days)",
   "default": "30"
  },
  {
   "fieldname": "make_exit_interview",
   "fieldtype": "Check",
   "label": "Make an Exit Interview When an Exit Is Approved",
   "default": "1"
  },
  {
   "fieldname": "column_break_exit",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "exit_template",
   "fieldtype": "Link",
   "label": "Exit Checklist",
   "options": "Raqeem Checklist Template",
   "description": "Made for the employee when an exit is approved (e.g. hand back laptop, clear custody)."
  },
  {
   "fieldname": "onboarding_template",
   "fieldtype": "Link",
   "label": "Onboarding Checklist",
   "options": "Raqeem Checklist Template",
   "description": "Made for every new employee (e.g. contract, email account, social security registration)."
  },
  {
   "fieldname": "section_gr",
   "fieldtype": "Section Break",
   "label": "End-of-Service Gratuity"
