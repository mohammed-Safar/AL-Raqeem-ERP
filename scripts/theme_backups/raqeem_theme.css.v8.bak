/* ==========================================================================
   ALRAQEEM — MODERN CARBON-ORANGE THEME (v6)
   ثيم حديث: خلفية كربونية، بطاقات ناعمة، نص فاتح مقروء، والبرتقالي للتمييز فقط
   ========================================================================== */


/* --------------------------------------------------------------------------
   1. Design tokens — الألوان والمقاسات
   -------------------------------------------------------------------------- */
:root {
    --rq-bg:          #0e1014;
    --rq-surface-1:   #15181e;
    --rq-surface-2:   #1b1f27;
    --rq-surface-3:   #232833;
    --rq-line:        rgba(255, 255, 255, 0.07);
    --rq-line-strong: rgba(255, 255, 255, 0.14);

    --rq-text:        #e8eaed;
    --rq-text-2:      #b4bac4;
    --rq-text-3:      #8a919c;

    --rq-accent:      #f97316;
    --rq-accent-2:    #fb923c;
    --rq-accent-deep: #ea580c;
    --rq-accent-soft: rgba(249, 115, 22, 0.12);
    --rq-accent-ring: rgba(249, 115, 22, 0.35);

    --rq-r-sm: 8px;
    --rq-r:    12px;
    --rq-r-lg: 16px;

    --rq-shadow:       0 1px 0 rgba(255,255,255,.03) inset, 0 1px 2px rgba(0,0,0,.35), 0 8px 24px rgba(0,0,0,.25);
    --rq-shadow-hover: 0 1px 0 rgba(255,255,255,.05) inset, 0 6px 14px rgba(0,0,0,.4), 0 16px 36px rgba(249,115,22,.10);
    --rq-ease: cubic-bezier(.2, .8, .2, 1);

    --rq-font: 'IBM Plex Sans Arabic', 'Cairo', system-ui, sans-serif;
    --rq-font-head: 'Cairo', 'IBM Plex Sans Arabic', system-ui, sans-serif;
}

/* --------------------------------------------------------------------------
   2. Frappe variable overrides — توجيه متغيرات فرابي لكل الوضعين
   -------------------------------------------------------------------------- */
:root,
[data-theme="light"],
[data-theme="dark"],
[data-theme-mode="light"],
[data-theme-mode="dark"] {
    color-scheme: dark;

    --white: #15181e !important;
    --black: #ffffff !important;

    --gray-50:  #121419 !important;
    --gray-100: #15181e !important;
    --gray-200: #1b1f27 !important;
    --gray-300: #232833 !important;
    --gray-400: #343a46 !important;
    --gray-500: #6b7280 !important;
    --gray-600: #8a919c !important;
    --gray-700: #b4bac4 !important;
    --gray-800: #e8eaed !important;
    --gray-900: #ffffff !important;
    --gray-950: #ffffff !important;

    --surface-base:        #15181e !important;
    --surface-white:       #15181e !important;
    --surface-gray-1:      #15181e !important;
    --surface-gray-2:      #1b1f27 !important;
    --surface-gray-3:      #232833 !important;
    --surface-gray-4:      #2c3240 !important;
    --surface-sidebar:     #111317 !important;
    --surface-elevation-1: #1b1f27 !important;
    --surface-elevation-2: #232833 !important;
    --surface-elevation-3: #2c3240 !important;

    --ink-base:   #0e1014 !important;   /* text on solid/inverted surfaces */
    --ink-gray-1: #3b4250 !important;
    --ink-gray-2: #5b6370 !important;
    --ink-gray-3: #8a919c !important;
    --ink-gray-4: #9ba2ad !important;
    --ink-gray-5: #b4bac4 !important;
    --ink-gray-6: #c9ced6 !important;
    --ink-gray-7: #dde0e5 !important;
    --ink-gray-8: #e8eaed !important;
    --ink-gray-9: #ffffff !important;

    --outline-gray-1: rgba(255,255,255,.07) !important;
    --outline-gray-2: rgba(255,255,255,.10) !important;
    --outline-gray-3: rgba(255,255,255,.16) !important;

    --text-color:        #e8eaed !important;
    --heading-color:     #ffffff !important;
    --text-muted:        #9ba2ad !important;
    --text-light:        #8a919c !important;
    --text-on-gray:      #e8eaed !important;
    --placeholder-color: #5b6370 !important;

    --primary:       #f97316 !important;
    --primary-hover: #ea580c !important;
    --btn-primary:   #f97316 !important;
    --border-color:  rgba(255,255,255,.08) !important;
    --dark-border-color: rgba(255,255,255,.12) !important;
    --highlight-color: rgba(249,115,22,.10) !important;
    --fg-color: #15181e !important;
    --bg-color: #0e1014 !important;
    --card-bg:  #15181e !important;
    --control-bg: #1b1f27 !important;
    --control-bg-on-gray: #232833 !important;

    /* bigger, more readable type scale (Frappe default: 11/12/13/14/16...) */
    --text-tiny: 12px !important;
    --text-2xs: 12px !important;
    --text-xs: 13px !important;
    --text-sm: 14.5px !important;
    --text-base: 15.5px !important;
    --text-md: 15.5px !important;
    --text-lg: 17.5px !important;
    --text-xl: 19px !important;
    --text-2xl: 21px !important;
    --text-3xl: 23px !important;
    --text-4xl: 27px !important;
    --text-p-xs: 13px !important;
    --text-p-sm: 14.5px !important;
    --text-p-base: 15.5px !important;
    --text-p-lg: 17.5px !important;

    --focus-default: 0 0 0 3px rgba(249,115,22,.35) !important;
    --focus-outline-default: 3px solid rgba(249,115,22,.45) !important;
    --checkbox-gradient: linear-gradient(135deg, #fb923c 0%, #ea580c 100%) !important;
    --checkbox-focus-shadow: 0 0 0 3px rgba(249,115,22,.35) !important;
    --subtle-fg: #1b1f27 !important;
    --fg-hover-color: #232833 !important;
    --table-border-color: rgba(255,255,255,.07) !important;
    --disabled-control-bg: #15181e !important;
    --input-disabled-bg: #15181e !important;
    --modal-bg: #15181e !important;
    --popover-bg: #1b1f27 !important;

    --code-block-bg: #0b0d11 !important;
    --code-block-text: #e5e7eb !important;
    --date-active-bg: #f97316 !important;
    --date-active-text: #1a0d03 !important;
    --primary-color: #f97316 !important;
    --awesomplete-hover-bg: rgba(249,115,22,.12) !important;
    --timeline-badge-bg: #1b1f27 !important;
    --timeline-badge-color: #b4bac4 !important;
    --text-neutral: #ffffff !important;
    --text-dark: #ffffff !important;

    --font-stack: 'IBM Plex Sans Arabic', 'Cairo', 'InterVariable', 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif !important;

    --sidebar-width: 260px !important;
    --sidebar-collapsed-width: 68px !important;
}

/* --------------------------------------------------------------------------
   3. Base — الخطوط والخلفية
   -------------------------------------------------------------------------- */
html, body {
    background-color: var(--rq-bg) !important;
    color: var(--rq-text) !important;
    font-family: var(--rq-font) !important;
    -webkit-font-smoothing: antialiased;
}
body {
    background-image:
        radial-gradient(900px 500px at 100% -10%, rgba(249,115,22,.07), transparent 60%),
        radial-gradient(700px 400px at 0% 110%, rgba(249,115,22,.04), transparent 60%) !important;
    background-attachment: fixed !important;
}
.page-container, .page-body, .layout-main, .layout-main-section-wrapper,
.editor-js-container, .layout-main-section {
    background-color: transparent !important;
    color: var(--rq-text) !important;
}

h1, h2, h3, h4, h5, h6, .page-title .title-text, .section-head {
    font-family: var(--rq-font-head) !important;
    color: #ffffff !important;
    font-weight: 700 !important;
    letter-spacing: -0.01em;
}
.page-title .title-text { font-weight: 800 !important; }

label, .control-label {
    color: var(--rq-text-2) !important;
    font-weight: 600 !important;
    font-size: .85rem !important;
}
.text-muted, .help-box, .frappe-control .help-box { color: var(--rq-text-3) !important; }
a { color: var(--rq-accent-2); }
a:hover { color: var(--rq-accent); }
::selection { background: var(--rq-accent-ring); color: #fff; }
hr { border-color: var(--rq-line) !important; }

/* --------------------------------------------------------------------------
   4. Navbar & page header — شريط علوي زجاجي
   -------------------------------------------------------------------------- */
header.navbar, .navbar {
    background: rgba(14, 16, 20, 0.72) !important;
    backdrop-filter: saturate(160%) blur(14px);
    -webkit-backdrop-filter: saturate(160%) blur(14px);
    border-bottom: 1px solid var(--rq-line) !important;
    box-shadow: none !important;
}
.page-head {
    background: rgba(14, 16, 20, 0.72) !important;
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--rq-line) !important;
}
.search-bar input, .navbar .awesomplete input {
    background: var(--rq-surface-2) !important;
    border: 1px solid var(--rq-line) !important;
    border-radius: 999px !important;
    color: var(--rq-text) !important;
}

/* --------------------------------------------------------------------------
   5. Sidebar — قائمة جانبية كبيرة بأيقونات داخل مربعات
   -------------------------------------------------------------------------- */
.body-sidebar, .desk-sidebar, .layout-side-section, .body-sidebar-container {
    background:
        linear-gradient(180deg, rgba(249,115,22,.05) 0%, transparent 30%),
        #101216 !important;
    border-color: var(--rq-line) !important;
}
.body-sidebar .standard-sidebar-item {
    border-radius: 12px !important;
    margin-block: 3px !important;
    background: transparent !important;
}
.body-sidebar .standard-sidebar-item .item-anchor {
    height: 44px !important;
    padding-inline: 6px 10px !important;
    border-radius: 12px !important;
    color: var(--rq-text-2) !important;
    transition: background .2s var(--rq-ease), color .2s var(--rq-ease), transform .2s var(--rq-ease) !important;
}
/* icon tile */
.body-sidebar .standard-sidebar-item .sidebar-item-icon {
    flex: 0 0 34px;
    width: 34px !important;
    height: 34px !important;
    border-radius: 10px;
    background: var(--rq-surface-2);
    box-shadow: inset 0 0 0 1px var(--rq-line);
    color: var(--rq-text-2);
    transition: background .25s var(--rq-ease), box-shadow .25s var(--rq-ease), transform .25s var(--rq-ease), color .25s var(--rq-ease);
}
.body-sidebar .standard-sidebar-item .sidebar-item-icon svg,
.body-sidebar .standard-sidebar-item .sidebar-item-icon img {
    width: 20px !important;
    height: 20px !important;
}
.body-sidebar .standard-sidebar-item .sidebar-item-label {
    font-size: 15px !important;
    font-weight: 500 !important;
    margin-inline-start: 12px !important;
    margin-left: 0;
    letter-spacing: 0 !important;
}
[dir="rtl"] .body-sidebar .standard-sidebar-item .sidebar-item-label { margin-left: 0 !important; }
/* hover */
.body-sidebar .standard-sidebar-item:not(.active-sidebar):hover .item-anchor {
    background: var(--rq-surface-2) !important;
    color: #fff !important;
}
.body-sidebar .standard-sidebar-item:hover .sidebar-item-icon {
    transform: scale(1.08) rotate(-4deg);
    color: var(--rq-accent-2);
    box-shadow: inset 0 0 0 1px rgba(249,115,22,.35);
}
/* active */
.body-sidebar .standard-sidebar-item.active-sidebar .item-anchor,
.body-sidebar .standard-sidebar-item.selected .item-anchor {
    background: linear-gradient(90deg, rgba(249,115,22,.16), rgba(249,115,22,.04)) !important;
    color: #fff !important;
}
[dir="rtl"] .body-sidebar .standard-sidebar-item.active-sidebar .item-anchor {
    background: linear-gradient(270deg, rgba(249,115,22,.16), rgba(249,115,22,.04)) !important;
}
.body-sidebar .standard-sidebar-item.active-sidebar .sidebar-item-icon,
.body-sidebar .standard-sidebar-item.selected .sidebar-item-icon {
    background: linear-gradient(135deg, #fb923c, #ea580c);
    color: #1a0d03;
    box-shadow: 0 4px 14px rgba(249,115,22,.45);
}
.body-sidebar .standard-sidebar-item.active-sidebar .sidebar-item-label,
.body-sidebar .standard-sidebar-item.selected .sidebar-item-label {
    color: #fff !important;
    font-weight: 700 !important;
}
/* group headings */
.body-sidebar .section-break .sidebar-item-label {
    color: var(--rq-text-3) !important;
    font-size: 12px !important;
    font-weight: 700 !important;
    letter-spacing: .08em;
    text-transform: uppercase;
}
.body-sidebar .item-anchor.section-break { height: 34px !important; }
.body-sidebar .item-anchor.section-break .sidebar-item-icon { display: none; }
/* collapsed rail: keep tiles centred */
@media (min-width: 768px) {
    .body-sidebar-container:not(.expanded) .body-sidebar .item-anchor {
        width: 48px !important;
        justify-content: center;
        padding: 0 !important;
        margin-inline: auto;
    }
}

/* --------------------------------------------------------------------------
   6. Buttons — أزرار حديثة
   -------------------------------------------------------------------------- */
.btn {
    border-radius: 10px !important;
    font-weight: 600 !important;
    transition: transform .12s var(--rq-ease), box-shadow .15s var(--rq-ease), background .15s var(--rq-ease) !important;
}
.btn:active { transform: translateY(1px) scale(.98); }
.btn-primary, button.btn-primary {
    background: linear-gradient(135deg, #fb923c 0%, #f97316 45%, #ea580c 100%) !important;
    color: #1a0d03 !important;
    font-weight: 700 !important;
    border: 0 !important;
    box-shadow: 0 4px 14px rgba(249,115,22,.30), inset 0 1px 0 rgba(255,255,255,.25) !important;
}
.btn-primary:hover {
    box-shadow: 0 6px 20px rgba(249,115,22,.42), inset 0 1px 0 rgba(255,255,255,.3) !important;
    filter: brightness(1.05);
}
.btn-default, .btn-secondary {
    background: var(--rq-surface-2) !important;
    color: var(--rq-text) !important;
    border: 1px solid var(--rq-line) !important;
    box-shadow: none !important;
}
.btn-default:hover, .btn-secondary:hover {
    background: var(--rq-surface-3) !important;
    border-color: var(--rq-line-strong) !important;
}

/* --------------------------------------------------------------------------
   7. Inputs — حقول بحلقة تركيز برتقالية
   -------------------------------------------------------------------------- */
.form-control, input.form-control, select.form-control, textarea.form-control,
.frappe-control input:not([type="checkbox"]):not([type="radio"]), .frappe-control select, .frappe-control textarea {
    background-color: var(--rq-surface-2) !important;
    border: 1px solid var(--rq-line) !important;
    border-radius: 10px !important;
    color: #f3f4f6 !important;
    transition: border-color .15s var(--rq-ease), box-shadow .15s var(--rq-ease), background .15s var(--rq-ease);
}
.form-control:hover, .frappe-control input:not([type="checkbox"]):not([type="radio"]):hover { border-color: var(--rq-line-strong) !important; }
.form-control:focus, .frappe-control input:not([type="checkbox"]):not([type="radio"]):focus,
.frappe-control select:focus, .frappe-control textarea:focus {
    background-color: var(--rq-surface-1) !important;
    border-color: var(--rq-accent) !important;
    box-shadow: 0 0 0 3px var(--rq-accent-ring) !important;
    outline: 0 !important;
}
.form-control::placeholder, input::placeholder { color: #5b6370 !important; }
.form-control[disabled], .form-control[readonly], .like-disabled-input {
    background: var(--rq-surface-1) !important;
    color: var(--rq-text-2) !important;
    border-style: dashed !important;
}

/* --------------------------------------------------------------------------
   8. Workspace — بطاقات + قوائم
   -------------------------------------------------------------------------- */
.editor-js-container .ce-header,
.editor-js-container .widget-group-title {
    font-family: var(--rq-font-head) !important;
    color: #ffffff !important;
    font-size: 1.05rem !important;
    display: flex; align-items: center; gap: 10px;
    margin-block: 22px 12px !important;
}
.editor-js-container .ce-header::before,
.editor-js-container .widget-group-title::before {
    content: "";
    width: 8px; height: 8px; border-radius: 3px;
    background: var(--rq-accent);
    box-shadow: 0 0 12px var(--rq-accent);
}

/* common widget card (edit-mode headers excluded) */
.widget:not(.header) {
    background: var(--rq-surface-1) !important;
    border: 1px solid var(--rq-line) !important;
    border-radius: var(--rq-r-lg) !important;
    box-shadow: var(--rq-shadow) !important;
    color: var(--rq-text) !important;
    transition: transform .18s var(--rq-ease), box-shadow .18s var(--rq-ease), border-color .18s var(--rq-ease) !important;
}
.widget .widget-title {
    font-family: var(--rq-font-head) !important;
    color: #ffffff !important;
    font-weight: 700 !important;
}
.widget .widget-subtitle { color: var(--rq-text-3) !important; }

/* shortcuts — cards */
.widget.shortcut-widget-box {
    background: linear-gradient(160deg, var(--rq-surface-2) 0%, var(--rq-surface-1) 100%) !important;
    padding: 16px 18px !important;
    min-height: 68px;
    position: relative;
    overflow: hidden;
}
.widget.shortcut-widget-box::after {
    content: "";
    position: absolute;
    inset-block: 14px;
    inset-inline-start: 0;
    width: 3px;
    border-start-start-radius: 0;
    border-end-start-radius: 0;
    border-start-end-radius: 3px;
    border-end-end-radius: 3px;
    background: var(--rq-accent);
    opacity: .55;
    transition: opacity .18s var(--rq-ease), inset .18s var(--rq-ease);
}
.widget.shortcut-widget-box:hover {
    transform: translateY(-3px);
    box-shadow: var(--rq-shadow-hover) !important;
    border-color: rgba(249,115,22,.35) !important;
}
.widget.shortcut-widget-box:hover::after { opacity: 1; inset-block: 8px; }
.widget.shortcut-widget-box .widget-title { font-size: .98rem !important; color: var(--rq-text) !important; }
.widget.shortcut-widget-box:hover .widget-title { color: #ffffff !important; }
.widget.shortcut-widget-box:focus-visible {
    outline: 0 !important;
    box-shadow: 0 0 0 3px var(--rq-accent-ring), var(--rq-shadow) !important;
}

/* number cards — stat cards */
.widget.number-widget-box {
    position: relative;
    overflow: hidden;
    padding: 18px 20px !important;
}
.widget.number-widget-box::before {
    content: "";
    position: absolute;
    inset-block-start: -40px;
    inset-inline-end: -40px;
    width: 120px; height: 120px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(249,115,22,.18), transparent 70%);
    pointer-events: none;
}
.widget.number-widget-box:hover {
    transform: translateY(-3px);
    box-shadow: var(--rq-shadow-hover) !important;
    border-color: rgba(249,115,22,.30) !important;
}
.widget.number-widget-box .widget-title {
    color: var(--rq-text-3) !important;
    font-family: var(--rq-font) !important;
    font-size: .82rem !important;
    font-weight: 600 !important;
}
/* white unless the Number Card has its own colour set */
.widget.number-widget-box .number:not([style*="color"]) { color: #ffffff !important; }
.widget.number-widget-box .number {
    font-family: var(--rq-font-head) !important;
    font-size: 2rem !important;
    font-weight: 800 !important;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
}

/* charts etc. */
.widget.dashboard-widget-box,
.widget.quick-list-widget-box,
.widget.onboarding-widget-box,
.widget.custom-block-widget-box { padding: 16px 18px !important; }

/* link cards — list panels */
.widget.links-widget-box {
    padding: 0 !important;
    overflow: hidden;
}
.widget.links-widget-box .widget-head {
    padding: 14px 18px !important;
    border-bottom: 1px solid var(--rq-line) !important;
    background: linear-gradient(180deg, rgba(255,255,255,.02), transparent) !important;
}
.widget.links-widget-box .widget-head .widget-title {
    color: #ffffff !important;
    font-size: .95rem !important;
}
.widget.links-widget-box .widget-body {
    margin: 0 !important;
    padding: 6px !important;
}
.widget.links-widget-box .link-item {
    display: flex !important;
    align-items: center;
    gap: 10px;
    padding: 9px 12px !important;
    border-radius: 10px;
    color: var(--rq-text-2) !important;
    text-decoration: none !important;
    transition: background .12s var(--rq-ease), color .12s var(--rq-ease);
}
.widget.links-widget-box .link-item::before {
    content: "";
    flex: 0 0 6px; height: 6px;
    border-radius: 50%;
    background: var(--rq-surface-3);
    box-shadow: 0 0 0 1px var(--rq-line-strong);
    transition: background .12s var(--rq-ease), box-shadow .12s var(--rq-ease);
}
.widget.links-widget-box .link-item::after {
    content: "›";
    margin-inline-start: auto;
    color: var(--rq-text-3);
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity .12s var(--rq-ease), transform .12s var(--rq-ease);
}
[dir="rtl"] .widget.links-widget-box .link-item::after { content: "‹"; transform: translateX(4px); }
.widget.links-widget-box .link-item:hover,
.widget.links-widget-box .link-item:focus-visible {
    background: var(--rq-surface-2) !important;
    color: #ffffff !important;
    text-decoration: none !important;
}
.widget.links-widget-box .link-item:hover::before { background: var(--rq-accent); box-shadow: 0 0 8px var(--rq-accent); }
.widget.links-widget-box .link-item:hover::after { opacity: 1; transform: none; color: var(--rq-accent-2); }
.widget.links-widget-box .link-item .disabled-link { color: #5b6370 !important; }
.widget.links-widget-box .link-description { color: var(--rq-text-3) !important; }

/* --------------------------------------------------------------------------
   9. List view — صفوف بشكل بطاقات رفيعة
   -------------------------------------------------------------------------- */
.frappe-list, .frappe-list .frappe-card, .layout-main-section.frappe-card {
    background: transparent !important;
    border: 0 !important;
    box-shadow: none !important;
}
.frappe-list .result { background: transparent !important; padding: 6px 4px !important; }
.frappe-list .list-row-head {
    background: var(--rq-surface-1) !important;
    border: 1px solid var(--rq-line) !important;
    border-radius: var(--rq-r) !important;
    color: var(--rq-text-3) !important;
    margin-bottom: 8px;
}
.frappe-list .list-row-head .list-row-col,
.frappe-list .list-row-head .list-subject {
    color: var(--rq-text-3) !important;
    font-size: .78rem !important;
    font-weight: 600 !important;
    letter-spacing: .03em;
}
.frappe-list .list-row-container {
    background: var(--rq-surface-1) !important;
    border: 1px solid var(--rq-line) !important;
    border-radius: var(--rq-r) !important;
    margin-bottom: 6px !important;
    position: relative;
    transition: border-color .15s var(--rq-ease), box-shadow .15s var(--rq-ease), transform .15s var(--rq-ease), background .15s var(--rq-ease);
}
.frappe-list .list-row-container:hover {
    background: var(--rq-surface-2) !important;
    border-color: rgba(249,115,22,.30) !important;
    box-shadow: var(--rq-shadow-hover) !important;
    transform: translateY(-1px);
}
.frappe-list .list-row, .frappe-list .list-row:hover {
    background: transparent !important;
    border: 0 !important;
}
.frappe-list .list-subject a, .frappe-list .list-subject .bold {
    color: var(--rq-text) !important;
    font-weight: 600 !important;
}
.frappe-list .list-row-container:hover .list-subject a { color: #ffffff !important; }
.frappe-list .list-row-col, .frappe-list .list-row-activity { color: var(--rq-text-2) !important; }
.list-paging-area { background: transparent !important; border: 0 !important; }

/* --------------------------------------------------------------------------
   10. Forms & tables — النماذج والجداول
   -------------------------------------------------------------------------- */
.form-page .form-section, .form-layout .form-section, .frappe-card {
    background: var(--rq-surface-1) !important;
    border-color: var(--rq-line) !important;
}
.form-layout, .form-page {
    border-radius: var(--rq-r-lg) !important;
}
.std-form-layout > .form-layout > .form-page {
    background: var(--rq-surface-1) !important;
    border: 1px solid var(--rq-line) !important;
    border-radius: var(--rq-r-lg) !important;
    box-shadow: var(--rq-shadow) !important;
    overflow: hidden;
}
.form-section.card-section, .form-dashboard-section {
    border-bottom: 1px solid var(--rq-line) !important;
    background: transparent !important;
}
.form-section .section-head {
    color: #ffffff !important;
    font-family: var(--rq-font-head) !important;
    font-size: 1.08rem !important;
    font-weight: 700 !important;
    display: flex;
    align-items: center;
    gap: 10px;
}
.form-section .section-head::before {
    content: "";
    flex: 0 0 4px;
    height: 18px;
    border-radius: 4px;
    background: linear-gradient(180deg, #fb923c, #ea580c);
    box-shadow: 0 0 10px rgba(249,115,22,.45);
}
.form-section .section-head.collapsible:hover { color: var(--rq-accent-2) !important; }
.form-section .section-head .collapse-indicator { margin-inline-start: auto; opacity: .7; }
.form-column .column-label { color: #fff !important; }
.form-section-description, .form-column-description { color: var(--rq-text-3) !important; }
.form-dashboard-section .section-head { font-size: .95rem !important; }
/* the read-only value of a field */
.control-value, .like-disabled-input, .static-area { color: var(--rq-text) !important; }
.frappe-control[data-fieldtype="Currency"] .control-value,
.frappe-control[data-fieldtype="Float"] .control-value { font-variant-numeric: tabular-nums; }
.form-tabs-list {
    background: transparent !important;
    border-bottom: 1px solid var(--rq-line) !important;
}
.form-tabs-list .nav-link { color: var(--rq-text-3) !important; border: 0 !important; }
.form-tabs-list .nav-link.active {
    color: #ffffff !important;
    box-shadow: inset 0 -2px 0 var(--rq-accent) !important;
}
.form-grid {
    border: 1px solid var(--rq-line) !important;
    border-radius: var(--rq-r) !important;
    overflow: hidden;
}
.grid-heading-row { background: var(--rq-surface-2) !important; color: var(--rq-text-3) !important; }
.grid-row { border-color: var(--rq-line) !important; }
.grid-body .rows .grid-row:hover { background: var(--rq-surface-2) !important; }

/* --------------------------------------------------------------------------
   11. Badges, dropdowns, modals — شارات وقوائم ونوافذ
   -------------------------------------------------------------------------- */
.indicator-pill, .badge, .indicator-pill-round {
    border-radius: 999px !important;
    font-weight: 600 !important;
}
.dropdown-menu, .awesomplete > ul, .popover {
    background: rgba(27, 31, 39, .96) !important;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--rq-line-strong) !important;
    border-radius: var(--rq-r) !important;
    box-shadow: 0 16px 40px rgba(0,0,0,.5) !important;
    padding: 6px !important;
}
.dropdown-item, .awesomplete > ul > li {
    border-radius: 8px !important;
    color: var(--rq-text-2) !important;
}
.dropdown-item:hover, .dropdown-item:focus, .awesomplete > ul > li:hover,
.awesomplete > ul > li[aria-selected="true"] {
    background: var(--rq-accent-soft) !important;
    color: #ffffff !important;
}
.modal-content {
    background: var(--rq-surface-1) !important;
    border: 1px solid var(--rq-line-strong) !important;
    border-radius: 18px !important;
    box-shadow: 0 30px 80px rgba(0,0,0,.6) !important;
    color: var(--rq-text) !important;
}
.modal-header, .modal-footer { border-color: var(--rq-line) !important; background: transparent !important; }
.modal-backdrop.show { opacity: .7 !important; backdrop-filter: blur(4px); }

/* --------------------------------------------------------------------------
   11b. Espresso components (Frappe 16) — الأزرار الجديدة، الإشعارات، الشارات
   -------------------------------------------------------------------------- */
.es-button {
    --bt-solid-bg: #f97316;
    --bt-solid-bg-hover: #fb8a3c;
    --bt-solid-bg-active: #ea580c;
    --bt-solid-fg: #1a0d03;
    --bt-fill-bg: var(--rq-surface-2);
    --bt-fill-bg-hover: var(--rq-surface-3);
    --bt-fill-bg-active: #2c3240;
    --bt-fg: var(--rq-text);
    --bt-border: var(--rq-line-strong);
    --bt-border-hover: rgba(255,255,255,.22);
    --bt-outline-bg-active: var(--rq-surface-3);
    --bt-disabled-bg: var(--rq-surface-1);
    --bt-disabled-fg: #5b6370;
    --bt-disabled-border: var(--rq-line);
    --bt-focus: 3px solid rgba(249,115,22,.45);
    border-radius: 10px !important;
    font-weight: 600;
    transition: transform .12s var(--rq-ease), box-shadow .2s var(--rq-ease), background .15s var(--rq-ease), filter .15s;
}
.es-button[data-theme="red"] {
    --bt-solid-bg: #dc2626;
    --bt-solid-bg-hover: #ef4444;
    --bt-solid-bg-active: #b91c1c;
    --bt-solid-fg: #ffffff;
}
.es-button:active:not(:disabled) { transform: translateY(1px) scale(.98); }
.es-button[data-variant="solid"]:not([data-theme="red"]) {
    background-image: linear-gradient(135deg, #fb923c 0%, #f97316 45%, #ea580c 100%);
    box-shadow: 0 4px 14px rgba(249,115,22,.30), inset 0 1px 0 rgba(255,255,255,.25);
    font-weight: 700;
    position: relative;
    overflow: hidden;
}
.es-button[data-variant="solid"]:not([data-theme="red"]):hover {
    box-shadow: 0 6px 20px rgba(249,115,22,.42), inset 0 1px 0 rgba(255,255,255,.3);
    filter: brightness(1.05);
}
.es-button[data-variant="solid"]:not([data-theme="red"])::after {
    content: "";
    position: absolute;
    inset-block: 0;
    left: -60%;
    width: 50%;
    background: linear-gradient(100deg, transparent, rgba(255,255,255,.45), transparent);
    transform: skewX(-20deg);
    transition: left .6s var(--rq-ease);
    pointer-events: none;
}
.es-button[data-variant="solid"]:not([data-theme="red"]):hover::after { left: 120%; }

/* toasts: dark glass card with orange edge */
.es-toast {
    background: rgba(27, 31, 39, .94) !important;
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    color: var(--rq-text) !important;
    border: 1px solid var(--rq-line-strong);
    border-inline-start: 3px solid var(--rq-accent);
    border-radius: 14px !important;
    box-shadow: 0 18px 44px rgba(0,0,0,.55) !important;
}
.es-toast * { color: inherit; }
.es-toast .es-toast__description { color: var(--rq-text-2) !important; }

/* tooltips: dark with a fine border */
.es-tooltip, .tooltip-inner {
    background: #232833 !important;
    color: var(--rq-text) !important;
    border: 1px solid var(--rq-line-strong);
    border-radius: 8px !important;
    box-shadow: 0 10px 24px rgba(0,0,0,.45) !important;
}

/* badges & indicator pills: soft tinted pills */
.es-badge { border-radius: 999px !important; font-weight: 600; }
.indicator-pill, .indicator-pill-right, .indicator-pill-round {
    padding-inline: 10px !important;
    border: 1px solid rgba(255,255,255,.06);
}
.indicator-pill::before, .indicator-pill-right::after {
    box-shadow: 0 0 6px currentColor;
}

/* --------------------------------------------------------------------------
   11c. Checkboxes, switches, radios — عناصر الاختيار
   -------------------------------------------------------------------------- */
input[type="checkbox"] {
    border: 1.5px solid #4b5563 !important;
    border-radius: 5px !important;
    background-color: var(--rq-surface-2);
    transition: background-color .15s var(--rq-ease), border-color .15s var(--rq-ease), box-shadow .15s var(--rq-ease);
}
input[type="checkbox"]:hover { border-color: var(--rq-accent) !important; }
input[type="checkbox"]:checked {
    background-color: #f97316 !important;
    background-image:
        url("data:image/svg+xml,%3Csvg viewBox='0 0 8 7' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 4L2.67 5.8L7 1.2' stroke='%231a0d03' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E"),
        linear-gradient(135deg, #fb923c 0%, #ea580c 100%) !important;
    background-size: 60%, 100% !important;
    border-color: transparent !important;
    box-shadow: 0 0 10px rgba(249,115,22,.35);
}
input[type="checkbox"]:disabled:checked,
input[type="checkbox"].disabled-selected {
    background-color: #4b5563 !important;
    background-image:
        url("data:image/svg+xml,%3Csvg viewBox='0 0 8 7' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 4L2.67 5.8L7 1.2' stroke='%23d1d5db' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E") !important;
    box-shadow: none;
}
input[type="radio"] { accent-color: #f97316; }
.switch .slider { background-color: #343a46 !important; }
.switch input:checked + .slider { background: linear-gradient(135deg, #fb923c, #ea580c) !important; }
.progress { background-color: var(--rq-surface-3) !important; border-radius: 999px !important; }
.progress-bar { background: linear-gradient(90deg, #fb923c, #ea580c) !important; border-radius: 999px; }

/* --------------------------------------------------------------------------
   11d. List page chrome — شريط الفلاتر والقائمة الجانبية
   -------------------------------------------------------------------------- */
.page-form {
    background: var(--rq-surface-1) !important;
    border: 1px solid var(--rq-line) !important;
    border-radius: var(--rq-r-lg) !important;
    margin-bottom: 10px !important;
    padding-block: 8px !important;
}
.page-form .standard-filter-section .form-control,
.page-form .frappe-control input {
    background: var(--rq-surface-2) !important;
}
.filter-selector .btn, .sort-selector .btn, .filter-button, .filter-x-button {
    border-radius: 10px !important;
}
.filter-button.btn-primary-light, .filter-selector .btn-primary-light {
    background: var(--rq-accent-soft) !important;
    color: var(--rq-accent-2) !important;
    border: 1px solid rgba(249,115,22,.3) !important;
}
.list-sidebar .list-sidebar-button, .list-sidebar .sidebar-action {
    border-radius: 10px !important;
}
.list-sidebar .list-sidebar-button:hover { background: var(--rq-surface-2) !important; }
.msg-box, .no-result {
    color: var(--rq-text-3) !important;
}
.msg-box .btn-primary, .no-result .btn-primary { margin-top: 10px; }
.msg-box svg, .no-result svg { opacity: .7; }

/* --------------------------------------------------------------------------
   11e. Reports & tables — التقارير وجداول البيانات
   -------------------------------------------------------------------------- */
.datatable {
    --dt-cell-bg: var(--rq-surface-1);
    --dt-header-cell-bg: var(--rq-surface-2);
    --dt-border-color: var(--rq-line);
    --dt-light-bg: var(--rq-accent-soft);
    --dt-selection-highlight-color: rgba(249,115,22,.10);
    --dt-text-color: var(--rq-text-2);
    --dt-light-red: rgba(239,68,68,.12);
    --dt-light-yellow: rgba(245,158,11,.12);
    --dt-primary-color: #f97316;
    background: var(--rq-surface-1) !important;
    border: 1px solid var(--rq-line);
    border-radius: var(--rq-r) !important;
    overflow: hidden;
}
.datatable .dt-cell { color: var(--rq-text) !important; }
.datatable .dt-header .dt-cell,
.datatable .dt-row-header .dt-cell {
    color: var(--rq-text-3) !important;
    font-weight: 600 !important;
    font-size: .85rem;
}
.datatable .dt-row:hover .dt-cell { background: var(--rq-surface-2) !important; }
.datatable .dt-cell--focus .dt-cell__content { box-shadow: inset 0 0 0 2px var(--rq-accent); }
.report-wrapper, .report-view .result, .chart-wrapper {
    background: transparent !important;
}
.group-by-sidebar .group-by-item, .report-summary {
    border-radius: 12px !important;
}
.report-summary {
    background: var(--rq-surface-1) !important;
    border: 1px solid var(--rq-line) !important;
}
.report-summary .summary-value { color: #fff !important; font-weight: 800 !important; }

/* frappe charts on dark */
.frappe-chart .chart-label, .frappe-chart .x.axis text, .frappe-chart .y.axis text,
.frappe-chart .legend-dataset-text, .frappe-chart text { fill: var(--rq-text-3) !important; }
.frappe-chart .line-horizontal, .frappe-chart .line-vertical,
.frappe-chart .y-markers line, .frappe-chart .x.axis line, .frappe-chart .y.axis line {
    stroke: rgba(255,255,255,.07) !important;
}
.graph-svg-tip, .svg-tip {
    background: #232833 !important;
    color: var(--rq-text) !important;
    border: 1px solid var(--rq-line-strong);
    border-radius: 10px !important;
}
.graph-svg-tip .title, .svg-tip .title { color: var(--rq-text-2) !important; }
.graph-svg-tip strong, .svg-tip strong { color: #fff !important; }

/* --------------------------------------------------------------------------
   11f. Kanban — لوحة كانبان
   -------------------------------------------------------------------------- */
.kanban .kanban-column {
    background: rgba(21, 24, 30, .7) !important;
    border: 1px solid var(--rq-line) !important;
    border-radius: var(--rq-r-lg) !important;
}
.kanban .kanban-column-header {
    color: #fff !important;
    font-family: var(--rq-font-head) !important;
}
.kanban .kanban-card {
    background: var(--rq-surface-2) !important;
    border: 1px solid var(--rq-line) !important;
    border-radius: var(--rq-r) !important;
    box-shadow: 0 2px 6px rgba(0,0,0,.3) !important;
    transition: transform .15s var(--rq-ease), box-shadow .15s var(--rq-ease), border-color .15s var(--rq-ease);
}
.kanban .kanban-card:hover {
    transform: translateY(-2px);
    border-color: rgba(249,115,22,.35) !important;
    box-shadow: var(--rq-shadow-hover) !important;
}
.kanban .kanban-card-title { color: var(--rq-text) !important; font-weight: 600; }
.kanban .kanban-card-doc, .kanban .kanban-card-meta { color: var(--rq-text-3) !important; }

/* --------------------------------------------------------------------------
   11g. Form extras — التعليقات والجدول الزمني والشريط الجانبي
   -------------------------------------------------------------------------- */
.form-sidebar .sidebar-label, .form-sidebar-label { color: var(--rq-text-3) !important; }
.form-sidebar a, .form-sidebar .form-sidebar-items a { color: var(--rq-text-2) !important; }
.form-sidebar a:hover { color: var(--rq-accent-2) !important; }
.new-timeline::before { border-color: var(--rq-line-strong) !important; }
.new-timeline .timeline-dot {
    background: var(--rq-surface-2) !important;
    border: 2px solid var(--rq-line-strong) !important;
}
.new-timeline .timeline-badge {
    background: var(--rq-surface-2) !important;
    border: 1px solid var(--rq-line) !important;
    color: var(--rq-text-2) !important;
    border-radius: 10px !important;
}
.new-timeline .timeline-content { color: var(--rq-text-2) !important; }
.new-timeline .timeline-message-box {
    background: var(--rq-surface-1) !important;
    border: 1px solid var(--rq-line) !important;
    border-radius: var(--rq-r) !important;
}
.comment-box .comment-input-wrapper .ql-container,
.comment-input-wrapper .ql-editor, .ql-editor {
    background: var(--rq-surface-2) !important;
    color: var(--rq-text) !important;
    border-radius: 10px;
}
.ql-toolbar.ql-snow, .ql-container.ql-snow { border-color: var(--rq-line) !important; }
.ql-snow .ql-stroke { stroke: var(--rq-text-2) !important; }
.ql-snow .ql-fill { fill: var(--rq-text-2) !important; }
.ql-editor.ql-blank::before { color: #5b6370 !important; }
.avatar .avatar-frame { box-shadow: 0 0 0 2px var(--rq-surface-1); }

/* date picker */
.datepicker {
    border-radius: 14px !important;
    border: 1px solid var(--rq-line-strong) !important;
    box-shadow: 0 18px 44px rgba(0,0,0,.55) !important;
    overflow: hidden;
}
.datepicker--cell.-current- { color: var(--rq-accent-2) !important; font-weight: 700; }
.datepicker--cell.-selected-, .datepicker--cell.-selected-.-current- {
    box-shadow: 0 4px 12px rgba(249,115,22,.35);
}

/* dialog alerts use the dark status palette */
.alert {
    border-radius: var(--rq-r) !important;
    border: 1px solid rgba(255,255,255,.06) !important;
}

/* safety: anything rendered as a printed page stays dark-on-white */
.print-format, .print-format * {
    --text-color: #1f2328;
    --heading-color: #111;
}
.print-format { background: #fff !important; color: #1f2328 !important; }
.print-format h1, .print-format h2, .print-format h3,
.print-format h4, .print-format h5, .print-format h6,
.print-format label { color: #111 !important; -webkit-text-fill-color: currentColor; }

/* --------------------------------------------------------------------------
   12. Scrollbar — شريط تمرير رفيع
   -------------------------------------------------------------------------- */
* { scrollbar-width: thin; scrollbar-color: #343a46 transparent; }
::-webkit-scrollbar { width: 10px; height: 10px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb {
    background: #2c3240;
    border-radius: 999px;
    border: 2px solid var(--rq-bg);
}
::-webkit-scrollbar-thumb:hover { background: #3b4250; }

/* --------------------------------------------------------------------------
   12b. Visual effects — مؤثرات بصرية
   -------------------------------------------------------------------------- */

/* ambient glow stays static: animating a fixed full-page background
   repaints the whole screen every frame, which is heavy on laptop GPUs */
body { background-size: 100% 100%, 100% 100% !important; }

/* pages fade up when you open them */
@keyframes rq-page-in {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: none; }
}
.page-container { animation: rq-page-in .45s var(--rq-ease) backwards; }

/* page title (Frappe 16: the last breadcrumb is the title) — gradient text */
.page-head .es-breadcrumbs li:last-child .es-breadcrumbs__label,
.page-head .page-title .title-text {
    background: linear-gradient(90deg, #ffffff 0%, #ffffff 40%, #fdba74 75%, #f97316 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    font-family: var(--rq-font-head) !important;
    font-weight: 800 !important;
}
.page-head .es-breadcrumbs li:last-child .es-breadcrumbs__item { font-size: 1.35rem !important; }
.page-head .es-breadcrumbs__item { color: var(--rq-text-3) !important; border-radius: 8px; }
.page-head a.es-breadcrumbs__item:hover { color: var(--rq-accent-2) !important; background: var(--rq-accent-soft); }
.page-head .es-breadcrumbs li + li::before { color: #3b4250 !important; }
.page-head .page-title .title-text { font-size: 1.6rem !important; }

/* workspace cards pop in one after another */
@keyframes rq-card-in {
    from { opacity: 0; transform: translateY(14px) scale(.98); }
    to   { opacity: 1; transform: none; }
}
.editor-js-container .ce-block {
    animation: rq-card-in .5s var(--rq-ease) backwards;
}
.editor-js-container .ce-block:nth-child(1)  { animation-delay: .02s; }
.editor-js-container .ce-block:nth-child(2)  { animation-delay: .05s; }
.editor-js-container .ce-block:nth-child(3)  { animation-delay: .08s; }
.editor-js-container .ce-block:nth-child(4)  { animation-delay: .11s; }
.editor-js-container .ce-block:nth-child(5)  { animation-delay: .14s; }
.editor-js-container .ce-block:nth-child(6)  { animation-delay: .17s; }
.editor-js-container .ce-block:nth-child(7)  { animation-delay: .20s; }
.editor-js-container .ce-block:nth-child(8)  { animation-delay: .23s; }
.editor-js-container .ce-block:nth-child(9)  { animation-delay: .26s; }
.editor-js-container .ce-block:nth-child(10) { animation-delay: .29s; }
.editor-js-container .ce-block:nth-child(n+11) { animation-delay: .32s; }

/* glowing gradient border on hovered cards */
.widget.shortcut-widget-box::before,
.widget.links-widget-box::before {
    content: "";
    position: absolute;
    inset: 0;
    padding: 1px;
    border-radius: inherit;
    background: linear-gradient(135deg, rgba(251,146,60,.9), rgba(249,115,22,0) 40%, rgba(249,115,22,0) 60%, rgba(251,146,60,.7));
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity .25s var(--rq-ease);
    pointer-events: none;
}
.widget.links-widget-box { position: relative; }
.widget.shortcut-widget-box:hover::before,
.widget.links-widget-box:hover::before { opacity: 1; }

/* spotlight that follows the top of a hovered card */
.widget.shortcut-widget-box,
.widget.number-widget-box {
    background-image:
        radial-gradient(400px 120px at 50% -40%, rgba(249,115,22,0), transparent 70%),
        linear-gradient(160deg, var(--rq-surface-2) 0%, var(--rq-surface-1) 100%) !important;
    transition: transform .25s var(--rq-ease), box-shadow .25s var(--rq-ease), border-color .25s var(--rq-ease), background-image .3s !important;
}
.widget.shortcut-widget-box:hover,
.widget.number-widget-box:hover {
    background-image:
        radial-gradient(400px 120px at 50% -40%, rgba(249,115,22,.16), transparent 70%),
        linear-gradient(160deg, var(--rq-surface-2) 0%, var(--rq-surface-1) 100%) !important;
}
.widget.shortcut-widget-box .widget-title { font-size: 1.05rem !important; }

/* number cards: glowing number + breathing corner light */
@keyframes rq-breathe {
    0%, 100% { opacity: .55; transform: scale(1); }
    50%      { opacity: 1;   transform: scale(1.15); }
}
.widget.number-widget-box::before { animation: rq-breathe 5s ease-in-out infinite; }
.widget.number-widget-box .number {
    font-size: 2.3rem !important;
    text-shadow: 0 0 24px rgba(249,115,22,.25);
}

/* section heading dot pulses */
@keyframes rq-pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(249,115,22,.55), 0 0 10px var(--rq-accent); }
    70%      { box-shadow: 0 0 0 8px rgba(249,115,22,0), 0 0 10px var(--rq-accent); }
}
.editor-js-container .ce-header::before,
.editor-js-container .widget-group-title::before { animation: rq-pulse 2.6s ease-out infinite; }
.editor-js-container .ce-header,
.editor-js-container .widget-group-title { font-size: 1.2rem !important; }

/* primary buttons: light sweep on hover */
.btn-primary { position: relative; overflow: hidden; }
.btn-primary::after {
    content: "";
    position: absolute;
    inset-block: 0;
    left: -60%;
    width: 50%;
    background: linear-gradient(100deg, transparent, rgba(255,255,255,.45), transparent);
    transform: skewX(-20deg);
    transition: left .6s var(--rq-ease);
    pointer-events: none;
}
.btn-primary:hover::after { left: 120%; }

/* list rows slide in */
@keyframes rq-row-in {
    from { opacity: 0; transform: translateX(-6px); }
    to   { opacity: 1; transform: none; }
}
[dir="rtl"] .frappe-list .list-row-container { animation-name: rq-row-in-rtl; }
@keyframes rq-row-in-rtl {
    from { opacity: 0; transform: translateX(6px); }
    to   { opacity: 1; transform: none; }
}
.frappe-list .list-row-container { animation: rq-row-in .35s var(--rq-ease) backwards; }
.frappe-list .list-row-container:nth-child(2) { animation-delay: .02s; }
.frappe-list .list-row-container:nth-child(3) { animation-delay: .04s; }
.frappe-list .list-row-container:nth-child(4) { animation-delay: .06s; }
.frappe-list .list-row-container:nth-child(5) { animation-delay: .08s; }
.frappe-list .list-row-container:nth-child(6) { animation-delay: .10s; }
.frappe-list .list-row-container:nth-child(7) { animation-delay: .12s; }
.frappe-list .list-row-container:nth-child(8) { animation-delay: .14s; }
.frappe-list .list-row-container:nth-child(n+9) { animation-delay: .16s; }
.frappe-list .list-row-container { padding-block: 4px; }
.frappe-list .list-subject a, .frappe-list .list-subject .bold { font-size: 15px !important; }

/* modals & dropdowns open with a soft zoom */
@keyframes rq-pop {
    from { opacity: 0; transform: translateY(6px) scale(.97); }
    to   { opacity: 1; transform: none; }
}
@keyframes rq-fade { from { opacity: 0; } to { opacity: 1; } }
/* dropdowns are placed by Popper via transform, so only fade them */
.dropdown-menu.show { animation: rq-fade .16s ease-out backwards; }
.modal.show .modal-content { animation: rq-pop .25s var(--rq-ease) backwards; }

/* inputs lift slightly when focused */
.frappe-control input:not([type="checkbox"]):not([type="radio"]):focus, .frappe-control textarea:focus, .form-control:focus {
    transform: translateY(-1px);
}

/* --------------------------------------------------------------------------
   12c. Arabic & RTL — العربية والاتجاه من اليمين لليسار
   -------------------------------------------------------------------------- */

/* form controls don't inherit fonts by default */
button, input, select, textarea, .btn, .es-button, .form-control {
    font-family: inherit;
}

/* Arabic is a joined script: any letter-spacing breaks the letters apart.
   Frappe's type classes and this theme both add tracking, so reset it all. */
html[lang^="ar"] body,
html[lang^="ar"] body *,
html[dir="rtl"] body,
html[dir="rtl"] body * {
    letter-spacing: normal !important;
    text-transform: none !important;
}

/* Arabic glyphs sit smaller and taller than Latin: give them room */
html[lang^="ar"] body,
html[dir="rtl"] body {
    line-height: 1.6;
}
html[dir="rtl"] h1, html[dir="rtl"] h2, html[dir="rtl"] h3,
html[dir="rtl"] h4, html[dir="rtl"] h5, html[dir="rtl"] h6,
html[dir="rtl"] .section-head, html[dir="rtl"] .widget-title,
html[dir="rtl"] .ce-header {
    line-height: 1.45 !important;
}
html[dir="rtl"] label, html[dir="rtl"] .control-label {
    font-size: .9rem !important;
    line-height: 1.5;
}
html[dir="rtl"] .form-control,
html[dir="rtl"] .frappe-control input:not([type="checkbox"]):not([type="radio"]) {
    line-height: 1.5;
}
html[dir="rtl"] .body-sidebar .standard-sidebar-item .sidebar-item-label { font-size: 15.5px !important; }
html[dir="rtl"] .body-sidebar .section-break .sidebar-item-label { font-size: 13.5px !important; }
html[dir="rtl"] .widget.links-widget-box .link-item { font-size: 15px; }
html[dir="rtl"] .widget.number-widget-box .widget-title { font-size: .9rem !important; }

/* gradient titles: start white at the right, where Arabic text begins */
html[dir="rtl"] .page-head .es-breadcrumbs li:last-child .es-breadcrumbs__label,
html[dir="rtl"] .page-head .page-title .title-text {
    background-image: linear-gradient(270deg, #ffffff 0%, #ffffff 40%, #fdba74 75%, #f97316 100%);
}

/* button light-sweep runs right-to-left */
html[dir="rtl"] .btn-primary::after,
html[dir="rtl"] .es-button[data-variant="solid"]:not([data-theme="red"])::after {
    left: auto;
    right: -60%;
    transform: skewX(20deg);
    transition: right .6s var(--rq-ease);
}
html[dir="rtl"] .btn-primary:hover::after,
html[dir="rtl"] .es-button[data-variant="solid"]:not([data-theme="red"]):hover::after {
    left: auto;
    right: 120%;
}

/* progress bars fill from the right */
html[dir="rtl"] .progress-bar { background: linear-gradient(270deg, #fb923c, #ea580c) !important; }

/* numbers, codes, emails and IDs stay left-to-right inside Arabic text */
html[dir="rtl"] .frappe-control[data-fieldtype="Currency"] input,
html[dir="rtl"] .frappe-control[data-fieldtype="Float"] input,
html[dir="rtl"] .frappe-control[data-fieldtype="Int"] input,
html[dir="rtl"] .frappe-control[data-fieldtype="Percent"] input {
    direction: ltr;
    text-align: right;
    font-variant-numeric: tabular-nums;
}
html[dir="rtl"] .frappe-control[data-fieldtype="Data"][data-fieldname*="email"] input,
html[dir="rtl"] .frappe-control[data-fieldtype="Data"][data-fieldname*="phone"] input,
html[dir="rtl"] .frappe-control[data-fieldtype="Data"][data-fieldname*="mobile"] input,
html[dir="rtl"] .frappe-control[data-fieldtype="Phone"] input,
html[dir="rtl"] input[type="email"], html[dir="rtl"] input[type="tel"], html[dir="rtl"] input[type="url"] {
    direction: ltr;
    text-align: right;
}
html[dir="rtl"] .widget.number-widget-box .number,
html[dir="rtl"] .datatable .dt-cell--col-numeric,
html[dir="rtl"] .list-row-col .ellipsis[title^="#"] {
    unicode-bidi: plaintext;
}

/* list-view links keep their arrow pointing the reading direction */
html[dir="rtl"] .widget.links-widget-box .link-item:hover { padding-inline-start: 12px !important; }

/* --------------------------------------------------------------------------
   13. Motion & phones — حركة وجوال
   -------------------------------------------------------------------------- */
@media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { transition: none !important; animation: none !important; }
    .widget:hover, .frappe-list .list-row-container:hover { transform: none !important; }
}
@media (max-width: 576px) {
    .widget.shortcut-widget-box { min-height: 58px; padding: 12px 14px !important; }
    .widget.number-widget-box .number { font-size: 1.55rem !important; }
    .frappe-list .list-row-container { border-radius: 10px !important; }
}
